# Copy this file to .env and fill in real values.
APP_ENV=local

# ---- Qdrant (vector store) ----
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=content_chunks_gemma

# ---- Embeddings (Ollama) ----
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=embeddinggemma:300m
EMBEDDING_DIM=768

# ---- Chunking ----
CHUNK_SIZE_TOKENS=700
CHUNK_OVERLAP_TOKENS=100
# "semantic" (embedding-similarity splits, better retrieval)
# or "simple" (fixed-size sliding window, faster fallback).
CHUNKING_STRATEGY=semantic

# ---- Upload limits ----
MAX_PDF_MB=50

# ---- LLM (local Ollama) ----
LLM_MODEL=qwen3:4b
LLM_TIMEOUT_SECONDS=120

# ---- Answers, question entity extraction and file translation (Groq) ----
GROQ_API_KEY=
ANSWER_MODEL=qwen/qwen3.8-27b
ANSWER_TIMEOUT_SECONDS=60
QUESTION_ENTITY_MODEL=qwen/qwen3.8-27b
TRANSLATION_MODEL=qwen/qwen3.8-27b
# Split long source text into requests; every part is processed.
TRANSLATION_BATCH_CHARS=2000
TRANSLATION_TIMEOUT_SECONDS=180

# ---- Connection extraction (uses the local LLM above) ----
EXTRACTION_BATCH_CHARS=2000
EXTRACTION_TIMEOUT_SECONDS=180

# ---- OCR (Tesseract) ----
# Windows: set the full path to tesseract.exe (there's no auto-discovery),
#   e.g. TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux/Mac: usually leave blank - Tesseract is found on the system PATH.
# If unset and Tesseract isn't on PATH, OCR (scanned PDFs, video frames) will fail.
TESSERACT_CMD=
# Installed Tesseract language codes, joined with +.
OCR_LANGUAGES=eng+fra+ara

# ---- Video frame sampling ----
# Sample one frame every N seconds (default 5). Lower = catch more, slower.
VIDEO_SAMPLE_SECONDS=5

# ---- Local video transcription (Whisper on CPU) ----
# No API key is required; the model downloads on first use.
WHISPER_MODEL=base
TRANSCRIBE_VIDEO=true

# Reserved for integrations that explicitly use the OpenAI API.
# Not required by the current video ingestion pipeline.
OPENAI_API_KEY=

# ---- Minutes of Meeting ----
# Max characters of transcript per LLM call before map-reduce kicks in
# (~4 chars/token; 12000 chars ~= 3000 tokens input).
MOM_BATCH_CHARS=12000

# ---- Video vision and synthesis (Gemini) ----
# Reads on-screen text and describes frames, then combines speech and visuals.
# Set DESCRIBE_FRAMES=false to use local OCR for frames.
GEMINI_API_KEY=
VISION_MODEL=gemini-3.5-flash-lite
VISION_TIMEOUT_SECONDS=120
DESCRIBE_FRAMES=true
SYNTHESIS_MODEL=gemini-3.5-flash-lite

# ---- Neo4j (graph database) ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=


# Wait after frame responses and between synthesis calls (seconds).
LLM_CALL_DELAY_SECONDS=5
